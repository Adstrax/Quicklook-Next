<Project Sdk="Microsoft.NET.Sdk">

    <!--
        v3.31.0: regression tests for the logic that used to be covered only by
        the GUI smoke test (test.ps1): command line parsing, the extension
        filter, and the settings store.

        The harness deliberately has no NuGet dependencies (no xUnit/test SDK) so
        it builds and runs on a machine without package access:

            dotnet run -c Release (from this folder)

        Exit code 0 = all tests passed, 1 = at least one failure.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AssemblyName>QuickLook.Tests</AssemblyName>
        <RootNamespace>QuickLook.Tests</RootNamespace>
        <LangVersion>latest</LangVersion>
        <UseWPF>true</UseWPF>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <IsPackable>false</IsPackable>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <Platforms>AnyCPU</Platforms>
        <NoWarn>$(NoWarn);CA1416</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\QuickLook.Common\QuickLook.Common.csproj" />
        <ProjectReference Include="..\QuickLookNext\QuickLookNext.csproj" />
        <!--
            v3.40.0: the WebView2 profile handling (stale lock repair, leftover
            sweep) lives in the shared host library.
        -->
        <ProjectReference Include="..\QuickLook.Plugin.Shared\QuickLook.Plugin.Shared.csproj" />
        <ProjectReference Include="..\QuickLook.Plugin\QuickLook.Plugin.OfficeViewer\QuickLook.Plugin.OfficeViewer.csproj" />
        <ProjectReference Include="..\QuickLook.Plugin\QuickLook.Plugin.XMindViewer\QuickLook.Plugin.XMindViewer.csproj" />
    </ItemGroup>

    <!--
        v6.1.3: the PDF page cache is pure WPF image bookkeeping. Compiling the
        one source file into the harness exercises the real implementation
        without making the tests load the PDF plugin and its native renderer.
    -->
    <ItemGroup>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfPageBitmapCache.cs">
            <Link>PdfPageBitmapCache.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\SingleDocumentCache.cs">
            <Link>SingleDocumentCache.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfThumbnailCache.cs">
            <Link>PdfThumbnailCache.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfThumbnailRequestScheduler.cs">
            <Link>PdfThumbnailRequestScheduler.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfPageIndexList.cs">
            <Link>PdfPageIndexList.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfPageRenderScheduler.cs">
            <Link>PdfPageRenderScheduler.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfPageRenderLimit.cs">
            <Link>PdfPageRenderLimit.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfPageDisplay.cs">
            <Link>PdfPageDisplay.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfSharpTile.cs">
            <Link>PdfSharpTile.cs</Link>
        </Compile>
        <Compile Include="..\QuickLook.Plugin\QuickLook.Plugin.PDFViewer\PdfTileCache.cs">
            <Link>PdfTileCache.cs</Link>
        </Compile>
    </ItemGroup>

</Project>

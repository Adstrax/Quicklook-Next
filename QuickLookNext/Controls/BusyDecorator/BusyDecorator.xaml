<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:busyDecorator="clr-namespace:QuickLookNext.Controls.BusyDecorator">

    <!-- Same reason as MainWindowStyles: this template is applied lazily, so it carries the
         embedded icon font it needs instead of relying on the application dictionary alone. -->
    <FontFamily x:Key="SegoeFluent">pack://application:,,,/QuickLook-Next;component/Fonts/#Segoe Fluent Icons</FontFamily>

    <Style TargetType="{x:Type busyDecorator:BusyDecorator}">
        <Setter Property="BusyStyle">
            <Setter.Value>
                <Style TargetType="{x:Type Control}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Control}">
                                <busyDecorator:SpinIcon FontFamily="{StaticResource SegoeFluent}"
                                                        FontSize="30"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Opacity="0.9"
                                                        Spin="True"
                                                        SpinDuration="1.2"
                                                        Text="&#xE72C;">
                                    <busyDecorator:SpinIcon.Effect>
                                        <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="1"
                                                          Opacity="0.45"
                                                          Color="Black" />
                                    </busyDecorator:SpinIcon.Effect>
                                </busyDecorator:SpinIcon>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

<UserControl x:Class="QuickLook.Plugin.InfoPanel.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="460"
             Height="216"
             FontSize="14"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <!-- v6.3.4: folder previews now use the same acrylic two-column scheme as application
    previews. The left pane owns the full window height so the icon remains optically centred
    in it, independently of the filename and metadata widths on the right. -->
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="192" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="1"
                Grid.Column="0"
                Width="148"
                Height="148"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="#0FFFFFFF"
                BorderBrush="{DynamicResource CaptionSeparatorBrush}"
                BorderThickness="1"
                CornerRadius="28">
            <Image x:Name="image"
                   Width="112"
                   Height="112"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True"
                   Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=image}" Value="{x:Null}">
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation BeginTime="0:0:0"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>

        <Rectangle Grid.Row="1"
                   Grid.Column="0"
                   Width="1"
                   Height="132"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Fill="{DynamicResource WindowTextForeground}"
                   Opacity="0.24">
            <Rectangle.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="0.22" Color="#FF000000" />
                    <GradientStop Offset="0.78" Color="#FF000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <Grid Grid.Row="1"
              Grid.Column="1"
              MaxWidth="238"
              Margin="22,0,8,0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="filename"
                       MaxHeight="50"
                       MaxWidth="238"
                       FontSize="22"
                       FontWeight="SemiBold"
                       LineHeight="27"
                       Foreground="{DynamicResource WindowTextForeground}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center">
                Filename.ext
            </TextBlock>

            <TextBlock Grid.Row="2"
                       Margin="0,3,0,4"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource WindowTextForeground}"
                       TextWrapping="Wrap"><Run x:Name="dateModifiedTitle" Text="Modified" /><Run Text=": " /><Run x:Name="modDate" Text="01/01/2017 00:00:00" />
            </TextBlock>

            <TextBlock Grid.Row="3"
                       Margin="0,3,0,4"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource WindowTextForeground}"
                       TextWrapping="Wrap"><Run x:Name="sizeTitle" Text="Size" /><Run Text=": " /><Run x:Name="totalSize" Text="Calculating size..." />
            </TextBlock>

            <TextBlock x:Name="numberLine"
                       Grid.Row="4"
                       Margin="0,3,0,4"
                       FontSize="14.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource WindowTextForeground}"
                       LineHeight="20"
                       LineStackingStrategy="BlockLineHeight"
                       TextWrapping="Wrap"
                       TextAlignment="Left"><Run x:Name="numberTitle" Text="Number" /><Run Text=": " /><Run x:Name="itemCount" Text="Counting items..." />
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>

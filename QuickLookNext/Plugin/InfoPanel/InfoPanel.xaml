<UserControl x:Class="QuickLook.Plugin.InfoPanel.InfoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:QuickLook.Plugin.InfoPanel"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Width="453"
             Height="196"
             FontSize="13"
             UseLayoutRounding="True"
             mc:Ignorable="d">
    <!-- v3.8.0: card-like layout - icon in a rounded tinted container, metadata
         rows with MDL2 glyphs and a calmer vertical rhythm. -->
    <Grid Margin="20,32,20,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="128" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Width="128"
                Height="128"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="12"
                Background="#0F000000">
            <Image x:Name="image"
                   Width="104"
                   Height="104"
                   Opacity="0"
                   Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="{x:Type Image}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Source, ElementName=image}" Value="{x:Null}">
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation BeginTime="0:0:0"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>

        <StackPanel Grid.Column="1"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center">
            <TextBlock x:Name="filename"
                       MaxHeight="50"
                       FontSize="17"
                       FontWeight="SemiBold"
                       LineHeight="24"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap">
                Filename.ext
            </TextBlock>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="&#xE787;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="11"
                           Margin="0,1,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
                <TextBlock x:Name="modDate"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}">
                    Last modified at 01/01/2017 00:00:00
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="&#xE8A5;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="11"
                           Margin="0,1,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}" />
                <TextBlock x:Name="totalSize"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource WindowTextForegroundAlternative}">
                    Calculating size...
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>

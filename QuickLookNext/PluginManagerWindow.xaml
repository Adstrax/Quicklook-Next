<Window x:Class="QuickLookNext.PluginManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Plugins"
        Width="700"
        Height="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="TintBrush" Color="#B8F8F6F4" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26000000" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1A1A1A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF7A7A7A" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#10000000" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#14000000" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#18005FB8" />
        <SolidColorBrush x:Key="BadgeTextBrush" Color="#FF005FB8" />
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#14000000" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#24000000" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFC42B1C" />

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="{DynamicResource ButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                            <!-- v5.3.0: the panel is reachable with Tab, so focus has to be visible. -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd"
                                        Property="BorderBrush"
                                        Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- v1.3.12: same look as the tray menu - non-layered WCA acrylic fills
         the whole rounded panel, DWM rounds the window including the blur. -->
    <Border x:Name="rootPanel"
            Background="{DynamicResource TintBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            KeyboardNavigation.TabNavigation="Cycle">
        <DockPanel Margin="14">
            <DockPanel x:Name="headerBar"
                       DockPanel.Dock="Top"
                       Margin="0,0,0,12">
                <Button x:Name="btnHeaderClose"
                        DockPanel.Dock="Right"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Padding="8,4"
                        Style="{DynamicResource PanelButtonStyle}"
                        Click="BtnHeaderClose_Click" />
                <TextBlock x:Name="headerText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Bottom"
                    BorderBrush="{DynamicResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="0,10,0,0"
                    Margin="0,12,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="btnOpenFolder"
                                Content="Open Plugin Folder"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnOpenFolder_Click"
                                Style="{DynamicResource PanelButtonStyle}" />
                        <Button x:Name="btnRefresh"
                                Content="Refresh"
                                Padding="12,6"
                                Margin="0,0,8,0"
                                Click="BtnRefresh_Click"
                                Style="{DynamicResource PanelButtonStyle}" />
                        <Button x:Name="btnClose"
                                Content="Close"
                                Padding="12,6"
                                Click="BtnClose_Click"
                                Style="{DynamicResource PanelButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="statusText"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </DockPanel>
            </Border>

            <!-- v5.3.0: 25 plugins are past the point where scrolling is a search interface. -->
            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource ButtonBgBrush}"
                    CornerRadius="6"
                    Padding="8,0,8,0"
                    Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Grid>
                        <TextBox x:Name="searchBox"
                                 Height="30"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}"
                                 CaretBrush="{DynamicResource TextBrush}"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown" />
                        <TextBlock x:Name="searchPlaceholder"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- v5.3.0: the list sits on a content plate of its own, so the rows (and their
                 version numbers) keep their contrast whatever the wallpaper behind the
                 translucent panel is doing. -->
            <Border Background="{DynamicResource ContentPlateBrush}"
                    CornerRadius="8"
                    Padding="6,8,6,2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="pluginList" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
